{
  "name": "hive.ausbit.dev",
  "version": "1.0.0",
  "description": "A block explorer and toolkit for the Hive blockchain",
  "productName": "hive.ausbit.dev",
  "author": "ausbitbank <ausbitbank@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build && node scripts/cf-compat.mjs && node scripts/generate-feed.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e-fast.mjs",
    "test:e2e:full": "playwright test",
    "test:e2e:build": "bun run build && playwright test",
    "test:e2e:fast:build": "bun run build && node scripts/e2e-fast.mjs",
    "e2e:install": "node scripts/install-obscura.mjs",
    "perf": "node scripts/perf-baseline.mjs",
    "perf:check": "node scripts/perf-baseline.mjs --check",
    "prerender": "node scripts/prerender.mjs",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@ecency/render-helper": "^2.5.47",
    "@hiveio/hive-js": "^2.0.9",
    "@hiveio/hivescript": "^1.4.0",
    "@hiveio/keychain": "^1.0.7",
    "@quasar/extras": "^2.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "gsap": "^3.15.1",
    "pinia": "^4.1.0",
    "quasar": "^2.35.4",
    "sjcl": "^1.0.9",
    "vue": "^3.5.45",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.58.2",
    "@quasar/app-vite": "^3.10.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "4.10.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.0.0",
    "jsdom": "^31.0.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 20",
    "npm": ">= 10"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
