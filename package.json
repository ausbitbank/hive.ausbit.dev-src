{
  "name": "banksia.io",
  "version": "1.0.0",
  "description": "Banksia is an open-source Hive explorer, wallet and creator toolkit.",
  "productName": "Banksia",
  "author": "ausbitbank <ausbitbank@gmail.com>",
  "license": "Unlicense",
  "homepage": "https://banksia.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ausbitbank/banksia.io.git"
  },
  "bugs": {
    "url": "https://github.com/ausbitbank/banksia.io/issues"
  },
  "keywords": [
    "hive",
    "blockchain",
    "explorer",
    "wallet",
    "banksia",
    "vue",
    "quasar"
  ],
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build && node scripts/cf-compat.mjs && node scripts/stamp-build.mjs && node scripts/generate-feed.mjs && node scripts/generate-home-snapshot.mjs",
    "lint": "eslint . && node scripts/check-theme-tokens.mjs",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:fast": "vitest run --tags-filter=\"!slow\"",
    "test:affected": "vitest run --tags-filter=\"!slow\" --changed",
    "test:unit": "vitest run",
    "test:all": "bun run test:unit && bun run test:e2e:build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e-run.mjs --config=playwright.functional.config.js",
    "test:e2e:full": "node scripts/e2e-run.mjs --config=playwright.config.js",
    "test:e2e:obscura": "E2E_BROWSER=obscura node scripts/e2e-run.mjs --config=playwright.obscura.config.js",
    "test:e2e:build": "bun run build && node scripts/e2e-run.mjs --config=playwright.config.js",
    "test:e2e:fast:build": "bun run build && node scripts/e2e-run.mjs --config=playwright.functional.config.js",
    "e2e:install": "node scripts/install-obscura.mjs",
    "perf": "node scripts/perf-baseline.mjs",
    "perf:check": "node scripts/perf-baseline.mjs --check",
    "prerender": "node scripts/prerender.mjs",
    "nginx:ips": "node scripts/refresh-cloudflare-ips.mjs",
    "cf:blog-dns": "node scripts/cloudflare-blog-dns.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "v4vapp:contract": "node scripts/v4vapp-contract-check.mjs",
    "devlog": "node scripts/devlog.mjs",
    "icons:subset": "node scripts/subset-icons.mjs"
  },
  "dependencies": {
    "@ecency/render-helper": "^2.5.47",
    "@hiveio/keychain": "^1.0.7",
    "@noble/hashes": "^1.8.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "hive-tx": "^7.4.2",
    "linkify-it": "^6.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.6",
    "sjcl": "^1.0.9",
    "uqr": "^0.1.3",
    "vue": "^3.5.46",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@quasar/app-vite": "^3.10.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "overrides": {
    "autolinker": "file:./scripts/stubs/autolinker"
  }
}
